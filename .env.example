# NexusMind AI — Environment Variables
# Copy to .env and fill in your values.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# --- Gemini API ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- Firestore ---
FIRESTORE_COLLECTION_TASKS=tasks
FIRESTORE_COLLECTION_MEMORY=agent_memory
FIRESTORE_COLLECTION_SKILLS=learned_skills

# --- Pub/Sub ---
PUBSUB_TOPIC_TASKS=nexusmind-tasks
PUBSUB_SUBSCRIPTION_TASKS=nexusmind-tasks-sub
PUBSUB_TOPIC_EVENTS=nexusmind-events

# --- Agent ---
AGENT_MAX_STEPS=20
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
ENVIRONMENT=development
DEBUG=false
