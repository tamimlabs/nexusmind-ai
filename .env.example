# NexusMind AI — Environment Variables
# Copy to .env and fill in your values.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# --- Storage Backend ---
# "sqlite"   = local SQLite (default, zero-config, full features)
# "firestore" = Google Cloud Firestore (for Cloud Run deployments)
DATABASE_BACKEND=sqlite

# --- Gemini API ---
GEMINI_API_KEY=your-gemini-api-key
# Comma-separated for rotation: GEMINI_API_KEY=key1,key2,key3
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_PRO=gemini-3.5-pro
# Rate throttle to your tier (free: 1 rps / 15 rpm) — auto from dashboard Settings
GEMINI_RPS=1
GEMINI_RPM=15
GEMINI_FULL_CONTROL=true

# --- Firestore (when DATABASE_BACKEND=firestore) ---
FIRESTORE_COLLECTION_TASKS=tasks
FIRESTORE_COLLECTION_MEMORY=agent_memory
FIRESTORE_COLLECTION_SKILLS=learned_skills

# --- Pub/Sub ---
PUBSUB_TOPIC_TASKS=nexusmind-tasks
PUBSUB_SUBSCRIPTION_TASKS=nexusmind-tasks-sub
PUBSUB_TOPIC_EVENTS=nexusmind-events

# --- Web Search (Google Custom Search -> DuckDuckGo fallback) ---
# Optional: Set these to use Google first (100 free/day), auto-falls back to DuckDuckGo
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# --- Approval Mode ---
# "always" = ask for every high-risk tool (safe but annoying)
# "smart"  = auto-approve safe commands, ask only for dangerous ones (recommended)
# "never"  = auto-approve everything (risky but fast)
APPROVAL_MODE=smart

# --- Telegram (Remote Approvals) ---
# Approve/deny actions from your phone while the agent runs autonomously
# 1. Message @BotFather on Telegram -> create bot -> copy token
# 2. Message @userinfobot -> copy your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub (for GitHub skill + watcher) ---
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# --- GitLab ---
GITLAB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

# --- Slack ---
SLACK_BOT_TOKEN=

# --- Discord ---
DISCORD_BOT_TOKEN=

# --- Jira ---
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_TOKEN=

# --- Email (IMAP) ---
EMAIL_IMAP_SERVER=
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- Agent ---
# Execution engine: "orchestrator" (adaptive loop — todos, live events, memory;
# default, the hackathon flagship) or "adk" (Google ADK Runner, Cloud Run demo).
EXECUTION_ENGINE=orchestrator
AGENT_MAX_STEPS=40
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300

# --- Watchers ---
WATCHER_DEFAULT_INTERVAL=300
WATCHER_MAX_CONCURRENT=10

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
ENVIRONMENT=development
DEBUG=false
